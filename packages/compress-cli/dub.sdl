name "compress-cli"
description "zipd: safe high-level D gzip-compatible CLI."
authors "zipd contributors"
license "BSL-1.0"
targetType "executable"
targetName "zipd"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"

buildType "release" {
    dflags "-preview=dip1000" "-O" "-release" "-inline"
}

dependency "zipd:compressor" path="../compressor"
dependency "symgc" path="/home/leonardo/Projetos/dmd/symgc"
subConfiguration "symgc" "standard"
