name "compressor"
description "Safe high-level DEFLATE encoder/decoder + gzip framing."
authors "zipd contributors"
license "BSL-1.0"
targetType "library"
sourcePaths "source"
importPaths "source"
dflags "-preview=dip1000"

buildType "release" {
    dflags "-preview=dip1000" "-O" "-release" "-inline"
}

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    targetType "library"
}
